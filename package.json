{
  "name": "session-marking",
  "version": "1.3.0",
  "private": true,
  "type": "module",
  "bin": {
    "session-marking": "./scripts/session-marking.mjs"
  },
  "scripts": {
    "test": "node --test tests/*.test.js",
    "check": "node --check scripts/session-marking.mjs && node --check scripts/sync-version.mjs",
    "sync:version": "node scripts/sync-version.mjs --marketplace .claude-plugin/marketplace.json",
    "verify:version": "node scripts/sync-version.mjs --check --marketplace .claude-plugin/marketplace.json",
    "verify": "npm run check && npm run verify:version && npm test"
  },
  "engines": {
    "node": ">=20"
  }
}
